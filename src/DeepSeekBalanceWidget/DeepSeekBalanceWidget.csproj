<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>DeepSeekBalanceWidget</RootNamespace>
    <AssemblyName>DeepSeekBalanceWidget</AssemblyName>
    <Version>0.5.0</Version>
    <AssemblyVersion>0.5.0.0</AssemblyVersion>
    <FileVersion>0.5.0.0</FileVersion>
    <Authors>wanghoufan</Authors>
    <Product>DeepSeek Balance Widget</Product>
    <Description>Windows desktop widget for monitoring DeepSeek API balance.</Description>
    <RepositoryUrl>https://github.com/wanghoufan/DeepSeekBalanceWidget</RepositoryUrl>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>
</Project>
