<Window x:Class="DeepSeekBalanceWidget.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Width="780" Height="600" MinWidth="720" MinHeight="540"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="#F5F6F8">
  <Window.Resources>
    <!-- Ant Design 5 风格色板 -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="#1677FF"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#4096FF"/>
    <SolidColorBrush x:Key="PrimaryActiveBrush" Color="#0958D9"/>
    <SolidColorBrush x:Key="PrimarySoftBrush" Color="#E6F4FF"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#D9D9D9"/>
    <SolidColorBrush x:Key="DividerBrush" Color="#F0F0F0"/>
    <SolidColorBrush x:Key="TextMainBrush" Color="#1F1F1F"/>
    <SolidColorBrush x:Key="TextSecondBrush" Color="#8C8C8C"/>
    <SolidColorBrush x:Key="CardBgBrush" Color="#FFFFFF"/>

    <!-- 输入框：统一高度 + 圆角 + 聚焦蓝边 -->
    <Style x:Key="InputBase" TargetType="Control">
      <Setter Property="Height" Value="30"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Foreground" Value="#1F1F1F"/>
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style TargetType="TextBox" BasedOn="{StaticResource InputBase}">
      <Setter Property="Padding" Value="8,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                            VerticalAlignment="Center" Focusable="False"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="PasswordBox" BasedOn="{StaticResource InputBase}">
      <Setter Property="Padding" Value="8,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="PasswordBox">
            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                            VerticalAlignment="Center" Focusable="False"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ComboBox">
      <Setter Property="Height" Value="30"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!-- 按钮：主按钮（蓝底白字）/ 次按钮（白底描边） -->
    <Style x:Key="PrimaryButton" TargetType="Button">
      <Setter Property="Height" Value="30"/>
      <Setter Property="Padding" Value="16,0"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                    CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimaryHoverBrush}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimaryActiveBrush}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Background" Value="#99C7FF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button">
      <Setter Property="Height" Value="30"/>
      <Setter Property="Padding" Value="12,0"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Foreground" Value="#1F1F1F"/>
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                    CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimarySoftBrush}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource PrimaryActiveBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 卡片容器 -->
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource CardBgBrush}"/>
      <Setter Property="BorderBrush" Value="#F0F0F0"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="16"/>
    </Style>

    <!-- 分组标题 -->
    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource TextMainBrush}"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>

    <Style x:Key="HintText" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{StaticResource TextSecondBrush}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- 左侧导航项（RadioButton 伪装） -->
    <Style x:Key="NavItem" TargetType="RadioButton">
      <Setter Property="Foreground" Value="#333333"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Rectangle x:Name="Indicator" Width="3" Fill="Transparent" VerticalAlignment="Stretch"/>
              <Border x:Name="Bd" Grid.Column="1" Background="Transparent" Padding="16,9"
                      Margin="0,2" CornerRadius="6">
                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left"/>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Indicator" Property="Fill" Value="{StaticResource PrimaryBrush}"/>
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimarySoftBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#F5F5F5"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <DockPanel>
    <!-- 底部操作栏：跨分区常驻 -->
    <Border DockPanel.Dock="Bottom" Padding="20,12" Background="White"
            BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="清除 Key" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0"
                Click="ClearKey_Click" ToolTip="清除 DeepSeek API Key"/>
        <Button Content="保存" Style="{StaticResource PrimaryButton}" Width="88" IsDefault="True"
                Click="Save_Click"/>
      </StackPanel>
    </Border>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="160"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- 左侧导航 -->
      <Border Grid.Column="0" Background="White"
              BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,1,0">
        <StackPanel Margin="16,20,12,0">
          <TextBlock Text="设置" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextMainBrush}"
                     Margin="4,0,0,18"/>
          <RadioButton x:Name="NavMonitoring" Style="{StaticResource NavItem}" GroupName="Nav"
                       Content="监测项" IsChecked="True" Click="Nav_Click"/>
          <RadioButton x:Name="NavAlerts" Style="{StaticResource NavItem}" GroupName="Nav"
                       Content="预警" Click="Nav_Click"/>
          <RadioButton x:Name="NavAppearance" Style="{StaticResource NavItem}" GroupName="Nav"
                       Content="界面" Click="Nav_Click"/>
          <RadioButton x:Name="NavGeneral" Style="{StaticResource NavItem}" GroupName="Nav"
                       Content="通用" Click="Nav_Click"/>
        </StackPanel>
      </Border>

      <!-- 右侧内容区 -->
      <Grid Grid.Column="1">
        <!-- ============ 监测项 ============ -->
        <ScrollViewer x:Name="PanelMonitoring" VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="24,22,24,20">
            <TextBlock Text="监测项" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextMainBrush}"/>
            <TextBlock Style="{StaticResource HintText}" Margin="0,4,0,16"
                       Text="各监测项可独立启停；关闭后胶囊与详细面板均隐藏对应区块。"/>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="14"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <!-- DS 卡片 -->
              <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Card}">
                <StackPanel>
                  <CheckBox x:Name="EnableDsCheck" Content="DeepSeek 余额" FontSize="13"
                            ToolTip="关闭后胶囊与详细面板均不显示 DS 区块"/>
                  <TextBlock Style="{StaticResource HintText}" Margin="22,-2,0,8" Text="读取 DeepSeek 开放平台余额"/>
                  <PasswordBox x:Name="ApiKeyBox" ToolTip="DeepSeek API Key（DPAPI 加密存储）"/>
                  <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button x:Name="TestDsBtn" Style="{StaticResource SecondaryButton}" Content="测试连接"
                            Width="86" Click="TestDs_Click"/>
                    <TextBlock x:Name="DsTestResult" Style="{StaticResource HintText}" Margin="10,0,0,0"
                               VerticalAlignment="Center" Foreground="#888888"/>
                  </StackPanel>
                </StackPanel>
              </Border>

              <!-- GPT 卡片 -->
              <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                  <CheckBox x:Name="EnableCodexCheck" Content="ChatGPT Plus 额度" FontSize="13"
                            ToolTip="通过本机已登录的 Codex 读取 ChatGPT Plus 用量窗口"/>
                  <TextBlock Style="{StaticResource HintText}" Margin="22,-2,0,8" Text="读本机 CC Switch 登录态，无需 Key"/>
                  <Grid Height="30"/>
                  <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button x:Name="TestCodexBtn" Style="{StaticResource SecondaryButton}" Content="测试连接"
                            Width="86" Click="TestCodex_Click"/>
                    <TextBlock x:Name="CodexTestResult" Style="{StaticResource HintText}" Margin="10,0,0,0"
                               VerticalAlignment="Center" Foreground="#888888"/>
                  </StackPanel>
                </StackPanel>
              </Border>

              <!-- WB 卡片 -->
              <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource Card}">
                <StackPanel>
                  <CheckBox x:Name="EnableWbCheck" Content="WorkBuddy 占位" FontSize="13"/>
                  <TextBlock Style="{StaticResource HintText}" Margin="22,-2,0,0" Text="无数据源，仅显示占位"/>
                </StackPanel>
              </Border>

              <!-- OC 卡片 -->
              <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                  <CheckBox x:Name="EnableOcCheck" Content="OpenCode Go 额度" FontSize="13"
                            ToolTip="读取 OpenCode Go 的 5 小时 / 周额度 / 月额度"/>
                  <TextBlock Style="{StaticResource HintText}" Margin="22,-2,0,8" Text="留空则自动读本机 auth.json"/>
                  <PasswordBox x:Name="OpenCodeKeyBox" ToolTip="OpenCode Go API Key（DPAPI 加密存储）"/>
                  <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button x:Name="TestOcBtn" Style="{StaticResource SecondaryButton}" Content="测试连接"
                            Width="86" Click="TestOc_Click"/>
                    <TextBlock x:Name="OcTestResult" Style="{StaticResource HintText}" Margin="10,0,0,0"
                               VerticalAlignment="Center" Foreground="#888888"/>
                  </StackPanel>
                </StackPanel>
              </Border>
            </Grid>
          </StackPanel>
        </ScrollViewer>

        <!-- ============ 预警 ============ -->
        <ScrollViewer x:Name="PanelAlerts" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="24,22,24,20">
            <TextBlock Text="预警" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextMainBrush}"/>
            <TextBlock Style="{StaticResource HintText}" Margin="0,4,0,16"
                       Text="低余额告警与额度预警共用警报声设置；GPT / OpenCode 额度预警共用档位与恢复判定。"/>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Style="{StaticResource SectionTitle}" Text="额度预警（GPT / OpenCode）"/>
                <CheckBox x:Name="EnableQuotaAlertCheck" Content="开启额度预警通知" FontSize="13" Margin="0,0,0,10"
                          ToolTip="剩余额度降到设定档位时弹窗预警；额度恢复到高位时也会通知"/>
                <Grid Margin="0,0,0,10">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0">
                    <TextBlock Style="{StaticResource HintText}" Text="预警档位（剩余%，逗号分隔）" Margin="0,0,0,4"/>
                    <TextBox x:Name="QuotaThresholdsBox"
                             ToolTip="例如 20, 10：剩余降到 20% 与 10% 时各提醒一次"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Style="{StaticResource HintText}" Text="恢复判定阈值（%）" Margin="0,0,0,4"/>
                    <TextBox x:Name="QuotaRecoveredBox"
                             ToolTip="低于该值后再回到该值，才播报“额度已恢复”"/>
                  </StackPanel>
                </Grid>
                <CheckBox x:Name="WeeklyAlertCheck" Content="周额度也参与预警" FontSize="13"
                          ToolTip="周额度耗尽需等一周才恢复，建议开启"/>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Style="{StaticResource SectionTitle}" Text="预警行为"/>
                <CheckBox x:Name="AlertSoundCheck" Content="播放警报声（低余额 / 额度预警 / 恢复提醒）" FontSize="13" Margin="0,0,0,10"/>
                <Grid Margin="0,0,0,10">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="警报声风格" FontSize="13" VerticalAlignment="Center" Margin="0,0,12,0"/>
                  <ComboBox x:Name="AlertSoundStyleBox" Grid.Column="1">
                    <ComboBoxItem Content="柔和（单音缓起伏）" Tag="Soft"/>
                    <ComboBoxItem Content="标准（双音交替）" Tag="Standard"/>
                    <ComboBoxItem Content="急促（短脉冲）" Tag="Urgent"/>
                  </ComboBox>
                  <Button x:Name="TestAlarmBtn" Grid.Column="2" Content="试听" Style="{StaticResource SecondaryButton}"
                          Width="56" Margin="10,0,0,0" Click="TestAlarm_Click" ToolTip="播放 3 秒警报声试听"/>
                </Grid>
                <Grid Margin="0,0,0,10">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="恢复提示音" FontSize="13" VerticalAlignment="Center" Margin="0,0,12,0"
                             ToolTip="额度恢复提醒专用提示音，11 种柔和音色可选，可与警报声设置成不同风格"/>
                  <ComboBox x:Name="RecoverySoundStyleBox" Grid.Column="1">
                    <ComboBoxItem Content="门铃叮咚（默认）" Tag="Chime"/>
                    <ComboBoxItem Content="八音盒" Tag="MusicBox"/>
                    <ComboBoxItem Content="清脆风铃" Tag="WindChime"/>
                    <ComboBoxItem Content="水滴" Tag="WaterDrop"/>
                    <ComboBoxItem Content="钢琴琶音" Tag="PianoArp"/>
                    <ComboBoxItem Content="竖琴滑音" Tag="HarpGliss"/>
                    <ComboBoxItem Content="木琴" Tag="Xylophone"/>
                    <ComboBoxItem Content="吉他拨弦" Tag="Guitar"/>
                    <ComboBoxItem Content="悠扬钟声" Tag="Bell"/>
                    <ComboBoxItem Content="鸟鸣" Tag="BirdChirp"/>
                    <ComboBoxItem Content="晨光舒缓" Tag="SunrisePad"/>
                  </ComboBox>
                  <Button x:Name="TestRecoverySoundBtn" Grid.Column="2" Content="试听" Style="{StaticResource SecondaryButton}"
                          Width="56" Margin="10,0,0,0" Click="TestRecoverySound_Click" ToolTip="播放 3 秒恢复提示音试听"/>
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                  <RadioButton x:Name="AlertContinuousRadio" Content="持续报警（点击「知道了」停止）" FontSize="13"
                               GroupName="AlertMode" Margin="0,0,20,0" VerticalAlignment="Center"/>
                  <RadioButton x:Name="AlertLimitedRadio" Content="限时" FontSize="13"
                               GroupName="AlertMode" Margin="0,0,10,0" VerticalAlignment="Center"/>
                  <ComboBox x:Name="AlertDurationBox" Width="90" FontSize="13"
                            ToolTip="限时模式下无人点击时，弹窗与提示音持续多久后自动消失；点「知道了」始终立即关闭">
                    <ComboBoxItem Content="10 秒" Tag="10"/>
                    <ComboBoxItem Content="30 秒" Tag="30"/>
                    <ComboBoxItem Content="1 分钟" Tag="60"/>
                  </ComboBox>
                </StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="警报窗位置" FontSize="13" VerticalAlignment="Center" Margin="0,0,12,0"/>
                  <ComboBox x:Name="AlertPositionBox" Grid.Column="1">
                    <ComboBoxItem Content="右上角" Tag="TopRight"/>
                    <ComboBoxItem Content="右侧中间" Tag="RightCenter"/>
                    <ComboBoxItem Content="右下角" Tag="BottomRight"/>
                  </ComboBox>
                </Grid>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Style="{StaticResource SectionTitle}" Text="低余额告警（DeepSeek）"/>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0">
                    <TextBlock Style="{StaticResource HintText}" Text="低余额阈值（元）" Margin="0,0,0,4"/>
                    <TextBox x:Name="ThresholdBox"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Style="{StaticResource HintText}" Text="异常下降百分比（%）" Margin="0,0,0,4"/>
                    <TextBox x:Name="ChangePercentBox"/>
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- ============ 界面 ============ -->
        <ScrollViewer x:Name="PanelAppearance" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="24,22,24,20">
            <TextBlock Text="界面" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextMainBrush}"/>
            <TextBlock Style="{StaticResource HintText}" Margin="0,4,0,16"
                       Text="胶囊外观、默认位置与区块顺序。"/>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Style="{StaticResource SectionTitle}" Text="行为"/>
                <CheckBox x:Name="TopmostCheck" Content="始终置顶" FontSize="13" Margin="0,0,0,8"/>
                <CheckBox x:Name="EdgeAutoHideCheck" Content="贴边自动隐藏" FontSize="13" Margin="0,0,0,8"
                          ToolTip="拖到桌面边缘后自动收起，鼠标移回窄边时展开"/>
                <CheckBox x:Name="MiniModeCheck" Content="迷你胶囊模式（默认收起）" FontSize="13" Margin="0,0,0,4"/>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Style="{StaticResource SectionTitle}" Text="高峰指示"/>
                <CheckBox x:Name="ShowPeakCheck" Content="显示高峰指示" FontSize="13" Margin="0,0,0,10"/>
                <TextBlock Style="{StaticResource HintText}" Text="高峰时段（预计，北京时间）" Margin="0,0,0,4"/>
                <StackPanel Orientation="Horizontal">
                  <TextBox x:Name="Peak1StartBox" Width="44" Text="9"/>
                  <TextBlock Text=" 至 " VerticalAlignment="Center" FontSize="13" Margin="4,0"/>
                  <TextBox x:Name="Peak1EndBox" Width="44" Text="12"/>
                  <TextBlock Text="    " VerticalAlignment="Center"/>
                  <TextBox x:Name="Peak2StartBox" Width="44" Text="14"/>
                  <TextBlock Text=" 至 " VerticalAlignment="Center" FontSize="13" Margin="4,0"/>
                  <TextBox x:Name="Peak2EndBox" Width="44" Text="18"/>
                  <TextBlock Text=" 时" VerticalAlignment="Center" FontSize="11" Foreground="#888888" Margin="4,0,0,0"/>
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Style="{StaticResource SectionTitle}" Text="额度文字"/>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0">
                    <TextBlock Style="{StaticResource HintText}" Text="字号（10-24）" Margin="0,0,0,4"/>
                    <TextBox x:Name="CodexFontSizeBox"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Style="{StaticResource HintText}" Text="样式" Margin="0,0,0,4"/>
                    <ComboBox x:Name="CodexFontStyleBox">
                      <ComboBoxItem Content="原版（半粗体）" Tag="DeepSeek"/>
                      <ComboBoxItem Content="常规" Tag="Regular"/>
                      <ComboBoxItem Content="粗体" Tag="Bold"/>
                    </ComboBox>
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Style="{StaticResource SectionTitle}" Text="位置与顺序"/>
                <TextBlock Style="{StaticResource HintText}" Text="默认位置" Margin="0,0,0,4"/>
                <ComboBox x:Name="CornerBox" Margin="0,0,0,14">
                  <ComboBoxItem Content="记忆上次位置" Tag="Remember"/>
                  <ComboBoxItem Content="右下角" Tag="BottomRight"/>
                  <ComboBoxItem Content="左下角" Tag="BottomLeft"/>
                </ComboBox>
                <TextBlock Style="{StaticResource HintText}" Text="胶囊区块顺序（上移 / 下移调整）" Margin="0,0,0,4"/>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="80"/>
                  </Grid.ColumnDefinitions>
                  <ListBox x:Name="AgentOrderBox" Height="104"/>
                  <StackPanel Grid.Column="1" Margin="10,0,0,0">
                    <Button Content="上移" Style="{StaticResource SecondaryButton}" Height="30" Click="AgentOrderUp_Click"/>
                    <Button Content="下移" Style="{StaticResource SecondaryButton}" Height="30" Margin="0,8,0,0" Click="AgentOrderDown_Click"/>
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- ============ 通用 ============ -->
        <ScrollViewer x:Name="PanelGeneral" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="24,22,24,20">
            <TextBlock Text="通用" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextMainBrush}"/>
            <TextBlock Style="{StaticResource HintText}" Margin="0,4,0,16"
                       Text="刷新频率、币种与系统级选项。"/>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Style="{StaticResource HintText}" Text="刷新间隔（秒，5-3600）" Margin="0,0,0,4"/>
                <TextBox x:Name="IntervalBox" Margin="0,0,0,16"/>
                <TextBlock Style="{StaticResource HintText}" Text="币种" Margin="0,0,0,4"/>
                <ComboBox x:Name="CurrencyBox" Margin="0,0,0,16">
                  <ComboBoxItem Content="CNY"/>
                  <ComboBoxItem Content="USD"/>
                </ComboBox>
                <CheckBox x:Name="MockCheck" Content="使用 Mock 数据（离线）" FontSize="13" Margin="0,0,0,8"/>
                <CheckBox x:Name="AutoStartCheck" Content="开机自启" FontSize="13"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Grid>
  </DockPanel>
</Window>
