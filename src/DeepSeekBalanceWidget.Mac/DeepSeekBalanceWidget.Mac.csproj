<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DeepSeekBalanceWidget</RootNamespace>
    <AssemblyName>DeepSeekBalanceWidget</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.4.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.3" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.3" />
  </ItemGroup>

  <!-- Reuse platform-neutral application logic. The WPF project stays untouched. -->
  <ItemGroup>
    <Compile Include="../DeepSeekBalanceWidget/Models/*.cs" Link="Models/%(Filename)%(Extension)" />
    <Compile Include="../DeepSeekBalanceWidget/Services/AlertEvaluator.cs" Link="Services/AlertEvaluator.cs" />
    <Compile Include="../DeepSeekBalanceWidget/Services/BalanceChangeCalculator.cs" Link="Services/BalanceChangeCalculator.cs" />
    <Compile Include="../DeepSeekBalanceWidget/Services/BalanceParser.cs" Link="Services/BalanceParser.cs" />
    <Compile Include="../DeepSeekBalanceWidget/Services/CcSwitchCodexUsageProvider.cs" Link="Services/CcSwitchCodexUsageProvider.cs" />
    <Compile Include="../DeepSeekBalanceWidget/Services/CodexAppServerClient.cs" Link="Services/CodexAppServerClient.cs" />
    <Compile Include="../DeepSeekBalanceWidget/Services/CodexConsumptionRateTracker.cs" Link="Services/CodexConsumptionRateTracker.cs" />
    <Compile Include="../DeepSeekBalanceWidget/Services/CodexUsageFormatter.cs" Link="Services/CodexUsageFormatter.cs" />
    <Compile Include="../DeepSeekBalanceWidget/Services/CodexQuotaAlertEvaluator.cs" Link="Services/CodexQuotaAlertEvaluator.cs" />
    <Compile Include="../DeepSeekBalanceWidget/Services/CodexUsageParser.cs" Link="Services/CodexUsageParser.cs" />
    <Compile Include="../DeepSeekBalanceWidget/Services/CurrencySelector.cs" Link="Services/CurrencySelector.cs" />
    <Compile Include="../DeepSeekBalanceWidget/Services/DeepSeekApiClient.cs" Link="Services/DeepSeekApiClient.cs" />
    <Compile Include="../DeepSeekBalanceWidget/Services/IBalanceProvider.cs" Link="Services/IBalanceProvider.cs" />
    <Compile Include="../DeepSeekBalanceWidget/Services/ICodexAccountsUsageProvider.cs" Link="Services/ICodexAccountsUsageProvider.cs" />
    <Compile Include="../DeepSeekBalanceWidget/Services/ICodexUsageProvider.cs" Link="Services/ICodexUsageProvider.cs" />
    <Compile Include="../DeepSeekBalanceWidget/Services/MockBalanceService.cs" Link="Services/MockBalanceService.cs" />
    <Compile Include="../DeepSeekBalanceWidget/Services/PeakHourCalculator.cs" Link="Services/PeakHourCalculator.cs" />
  </ItemGroup>
</Project>
